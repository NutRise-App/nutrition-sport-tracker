# Active Spring profile
SPRING_PROFILES_ACTIVE=dev

# Development database
DEV_DB_URL=jdbc:mysql://localhost:3306/beslenme_db?useUnicode=true&characterEncoding=utf8&serverTimezone=Europe/Istanbul
DEV_DB_USERNAME=root
DEV_DB_PASSWORD=CHANGE_ME

# JWT
JWT_SECRET=GENERATE_A_STRONG_RANDOM_SECRET
JWT_EXPIRATION=86400000

# Mail
MAIL_USERNAME=dev@example.invalid
MAIL_PASSWORD=CHANGE_ME

# External APIs
OPENROUTER_API_KEY=CHANGE_ME
USDA_API_KEY=CHANGE_ME

# CORS
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*

# -------------------------------------------------
# Production database
# Configure these in Railway or the deployment platform.
# Do not store real production values in this file.
# -------------------------------------------------
SPRING_DATASOURCE_URL=CHANGE_ME
SPRING_DATASOURCE_USERNAME=CHANGE_ME
SPRING_DATASOURCE_PASSWORD=CHANGE_ME

# Production configuration examples
SCHEDULING_ENABLED=true
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO
LOG_LEVEL_HIBERNATE=WARN

# Production CORS must use the real HTTPS application origin.
# Example: https://app.example.com

# -------------------------------------------------
# Docker Compose local environment
# -------------------------------------------------
MYSQL_DATABASE=beslenme_db
MYSQL_USER=nutrise
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_PORT=3307
BACKEND_PORT=8080
